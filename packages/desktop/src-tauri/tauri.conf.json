{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proyecto Shiro",
  "version": "0.1.0",
  "identifier": "com.pipelol.proyecto-shiro",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Proyecto Shiro",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:* http://localhost:*; img-src 'self' data: blob:; media-src 'self' blob: http://localhost:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Pipelol0723/proyecto-shiro/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFQzIwMEUwNTVBMDg0ODMKUldTRGhLQlY0QURDZnNoVVVKWHgwc3dwZVNZSnlXUW9PTlVJYWJDNVZaMWlpeWlYbjM0Q2xFZmkK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Pipelol",
    "shortDescription": "AI Companion modular con avatar tipo VTuber, voz y memoria persistente",
    "longDescription": "Proyecto Shiro es un AI Companion modular tipo VTuber con voz en tiempo real, memoria persistente y avatar Live2D. Pensado para escalar de app desktop a sistema con múltiples clientes.",
    "externalBin": ["binaries/core-host"],
    "resources": {
      "binaries/better_sqlite3.node": "better_sqlite3.node",
      "resources/modules.config.yaml": "modules.config.yaml",
      "resources/default.yaml": "default.yaml"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["es-ES", "en-US"]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
