{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities por defecto del binario Shiro. Incluye permisos amplios declarados desde V1 (ADR 0024 §5) para evitar romper la cadena de auto-updater cuando lleguen los hitos agentic (ADR 0022) y self-improvement (ADR 0023). Los plugins `fs`, `shell` y `dialog` están listados aquí pero NO hay comandos IPC custom que los invoquen — eso es lo que mantiene el binario `runtime-denied` en V1.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:app:allow-version",
    "core:app:allow-name",
    "core:event:default",
    "core:tray:default",
    "log:default",
    "notification:default",
    "window-state:default",

    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-rename",

    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-open",

    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
