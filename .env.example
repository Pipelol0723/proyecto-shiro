# Plantilla de variables de entorno para Proyecto Shiro.
# Copiar a `.env` (NUNCA commitear) y rellenar.

# ─── core-host (server Node) ──────────────────────────────────────────
# Puerto del WebSocket. Default 9876. Configurable porque puede chocar
# con otros procesos en la misma máquina.
SHIRO_HOST_PORT=9876

# Nivel de log. 'debug' | 'info' | 'warn' | 'error'. Default 'info'.
LOG_LEVEL=info

# ─── LLMs (llegan en PR 5 y PR 6) ─────────────────────────────────────
# Host de Ollama local. Default http://localhost:11434.
OLLAMA_HOST=http://localhost:11434

# API key de Anthropic. Se usa cuando el HybridRouter decide cloud.
# Sin esto, AnthropicLLM falla — el HybridRouter caerá a local.
ANTHROPIC_API_KEY=

# ─── cliente desktop (Vite, prefijo VITE_) ────────────────────────────
# URL del core-host. Default ws://localhost:9876/bus.
VITE_SHIRO_HOST_URL=ws://localhost:9876/bus
