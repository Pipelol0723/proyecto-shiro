# Plantilla de variables de entorno para Proyecto Shiro.
# Copiar a `.env` (NUNCA commitear) y rellenar.

# ─── core-host (server Node) ──────────────────────────────────────────
# Puerto del WebSocket. Default 9876. Configurable porque puede chocar
# con otros procesos en la misma máquina.
SHIRO_HOST_PORT=9876

# Host en el que escucha el core-host (bus WebSocket y /audio). Default
# 127.0.0.1: solo esta máquina. El bus todavía no tiene token (ADR 0027), así
# que 0.0.0.0 lo deja abierto a toda la red: es un opt-in consciente y el
# core-host avisa en el log al arrancar. Con una IP de red concreta, además,
# deja de escuchar en loopback: el cliente de esta máquina tendría que apuntar
# VITE_SHIRO_HOST_URL a esa IP y el audio no sonaría (se anuncia en localhost).
SHIRO_BIND_HOST=127.0.0.1

# Nivel de log. 'debug' | 'info' | 'warn' | 'error'. Default 'info'.
LOG_LEVEL=info

# Rutas del YAML de módulos y del personaje, relativas al cwd del core-host
# (packages/core-host). Defaults:
# SHIRO_MODULES_CONFIG=../../config/modules.config.yaml
# SHIRO_CHARACTER=../core/src/character/characters/default.yaml

# ─── LLMs ─────────────────────────────────────────────────────────────
# El core-host NO lee OLLAMA_HOST: el host sale de llm.local.config.host en
# config/modules.config.yaml. Solo lo usa el test en vivo de Ollama
# (OLLAMA_INTEGRATION=1).
# OLLAMA_HOST=http://localhost:11434

# API key de Anthropic. Se usa cuando el HybridRouter decide cloud.
# Sin esto, AnthropicLLM falla — el HybridRouter caerá a local.
ANTHROPIC_API_KEY=

# ─── TTS ──────────────────────────────────────────────────────────────
# API key de ElevenLabs (voz neuronal). Sin ella, el core-host arranca y todo
# sale por SystemTTS.
ELEVENLABS_API_KEY=

# ─── Memoria (Letta) ──────────────────────────────────────────────────
# Password del servidor Letta self-hosted (auth Bearer). La MISMA variable
# configura el contenedor (docker-compose) y el cliente (LettaMemory) — una
# sola fuente de verdad. Elige una cadena cualquiera y mantenla en secreto.
# Si la dejas vacía, arranca Letta SIN SECURE (solo recomendable en local).
# Ver ADR 0018.
LETTA_SERVER_PASSWORD=

# ─── cliente desktop (Vite, prefijo VITE_) ────────────────────────────
# URL del core-host. Default ws://localhost:9876/bus.
VITE_SHIRO_HOST_URL=ws://localhost:9876/bus

# ─── STT (Whisper, lo lee docker-compose) ─────────────────────────────
# Opcionales; estos son los defaults de compose. En GPUs Pascal (GTX 10xx) usa int8.
# WHISPER_MODEL=small
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=es
# WHISPER_PARTIAL_INTERVAL_MS=2500
# WHISPER_HOTWORDS=Shiro
