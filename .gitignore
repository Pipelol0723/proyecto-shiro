# Dependencias
node_modules/
.pnpm-store/

# Build
dist/
build/
*.tsbuildinfo

# Runtime
.env
.env.local
*.log
.DS_Store
Thumbs.db
# Backups locales (p. ej. .env.corrupt.bak tras recuperar de encoding roto).
# Solo se generan al hacer rescue manual; nunca deben llegar al repo.
*.bak

# Editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Claude Code (configuración personal de cada dev)
.claude/settings.local.json

# Tauri
src-tauri/target/

# Live2D SDK + modelos (propietarios, descarga manual cada dev)
**/Live2DCubismCore.*
**/CubismSdkForWeb-*/
**/live2d/Core/
**/live2d/models/
*.moc3
*.cmo3
*.model3.json
*.exp3.json
*.physics3.json
*.motion3.json
*.cdi3.json

# Tests
coverage/
.nyc_output/

# Modelos pesados (Whisper, etc.)
*.bin
*.gguf
models/

# WAL local de memoria (LocalMemory SQLite). Persistente por dev y máquina;
# nunca se commitea. Ver ADR 0017.
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Python caches del microservicio Whisper. Lo importamos puntualmente
# desde checks locales y deja bytecode; nunca debe entrar al repo.
__pycache__/
*.pyc