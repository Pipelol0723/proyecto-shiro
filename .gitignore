# Dependencias
node_modules/
.pnpm-store/

# Build
dist/
build/
*.tsbuildinfo

# Runtime
.env
.env.local
*.log
.DS_Store
Thumbs.db
# Backups locales (p. ej. .env.corrupt.bak tras recuperar de encoding roto).
# Solo se generan al hacer rescue manual; nunca deben llegar al repo.
*.bak

# Editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Claude Code (configuración personal de cada dev)
.claude/settings.local.json

# Tauri build artifacts (Rust compilation, gen schemas, bundles).
**/src-tauri/target/
**/src-tauri/gen/

# Sidecar del core-host: el .exe empaquetado, el binario nativo de SQLite
# y las configs copiadas como recursos los genera `npm run build:sidecar`
# (ver packages/desktop/scripts/build-sidecar.mjs). No se commitean — se
# reconstruyen en cada release. Ver ADR 0024 §2.
**/src-tauri/binaries/
**/src-tauri/resources/
**/.sidecar-build/

# Iconos del binario Tauri — placeholders SÍ commiteados (desktop) para que
# el release CI pueda buildear sin un paso de generación (ADR 0024 §7, §8).
# Son placeholders temporales; se reemplazan cuando llegue el branding real.
# Las subcarpetas android/ios que `tauri icon` también genera quedan fuera:
# V1 es Windows-only (ADR 0024), se regeneran cuando toque mobile.
**/src-tauri/icons/android/
**/src-tauri/icons/ios/

# Estado local de Claude Code (worktrees, settings de sesión).
.claude/

# Tauri signing key local (cuando se genere para el auto-updater, task #35).
# La pública entra en `tauri.conf.json`; la privada NUNCA al repo.
**/.tauri/
*.tauri-signing-key

# Live2D SDK + modelos (propietarios, descarga manual cada dev)
**/Live2DCubismCore.*
**/CubismSdkForWeb-*/
**/live2d/Core/
**/live2d/models/
*.moc3
*.cmo3
*.model3.json
*.exp3.json
*.physics3.json
*.motion3.json
*.cdi3.json

# Tests
coverage/
.nyc_output/

# Modelos pesados (Whisper, etc.)
*.bin
*.gguf
models/

# WAL local de memoria (LocalMemory SQLite). Persistente por dev y máquina;
# nunca se commitea. Ver ADR 0017.
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Python caches del microservicio Whisper. Lo importamos puntualmente
# desde checks locales y deja bytecode; nunca debe entrar al repo.
__pycache__/
*.pyc